# Neon Postgres connection string
# Get it from https://console.neon.tech/ → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# Shared password for /admin access. Use a strong value in production.
ADMIN_PASSWORD="change-me-to-strong-password"

# Secret used to sign soldier identification cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-hex-string"
